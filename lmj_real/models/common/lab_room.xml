<!-- The lab as seen from the X2's head camera, eyeballed from one fisheye frame.

     Frame: the robot stands at the origin facing +x on the near end of the plywood floor;
     +y is its left. Every size and position is a guess from that single image, good to
     maybe 20-30 cm; measure the room before trusting any of it for contact.

     The plywood is drawn flush with the floor (visual only, the floor plane carries the
     contact): one photo can't tell whether it is raised. Walls and ceiling are in group 4 so
     the viewer's outside camera can see in; press 4 to show them. Nothing is modelled behind
     the robot. -->
<mujoco model="lab_room">
  <asset>
    <texture name="lab_floor_tex" type="2d" builtin="flat" width="512" height="512"
             rgb1="0.42 0.43 0.44" mark="random" random="0.08" markrgb="0.15 0.15 0.16"/>
    <material name="lab_floor" texture="lab_floor_tex" texrepeat="6 6" texuniform="true"/>
    <texture name="lab_ply_tex" type="2d" builtin="flat" width="512" height="512"
             rgb1="0.80 0.71 0.56" mark="random" random="0.03" markrgb="0.62 0.52 0.38"/>
    <material name="lab_ply" texture="lab_ply_tex" texrepeat="4 4" texuniform="true"/>
    <material name="lab_wall" rgba="0.93 0.93 0.92 1"/>
    <material name="lab_cabinet" rgba="0.95 0.95 0.94 1" specular="0.2"/>
    <material name="lab_seam" rgba="0.55 0.55 0.55 1"/>
    <material name="lab_door" rgba="0.86 0.87 0.88 1"/>
    <material name="lab_dark" rgba="0.08 0.08 0.09 1"/>
    <material name="lab_grey" rgba="0.35 0.36 0.38 1"/>
    <material name="lab_blue" rgba="0.15 0.45 0.75 1"/>
    <material name="lab_cardboard" rgba="0.70 0.55 0.35 1"/>
    <material name="lab_wood" rgba="0.55 0.40 0.25 1"/>
    <material name="lab_red" rgba="0.85 0.15 0.10 1"/>
  </asset>

  <default>
    <default class="lab">
      <geom type="box" contype="1" conaffinity="1" condim="3" friction="0.8 0.02 0.01"/>
      <default class="lab_visual">
        <geom contype="0" conaffinity="0"/>
      </default>
      <default class="lab_shell">
        <geom group="4" material="lab_wall"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light name="lab_ceiling_1" pos="1.0 0.5 3.3" dir="0 0 -1" diffuse="0.35 0.35 0.35" castshadow="false"/>
    <light name="lab_ceiling_2" pos="4.0 0.5 3.3" dir="0 0 -1" diffuse="0.35 0.35 0.35" castshadow="false"/>
    <light name="lab_fill_right" directional="true" dir="0.2 -0.7 -0.6" diffuse="0.45 0.45 0.45" castshadow="false"/>
    <light name="lab_fill_left" directional="true" dir="0.2 0.7 -0.6" diffuse="0.45 0.45 0.45" castshadow="false"/>

    <!-- A first-person check against the photo: a pinhole stand-in for the head camera. -->
    <camera name="lab_head_view" pos="0.08 0 1.24" xyaxes="0 -1 0 0.53 0 0.848" fovy="100"/>

    <!-- floor: speckled grey epoxy, and two plywood sheets 2.5 x 2.0 m, seam at x = 1.9 -->
    <geom name="lab_floor" class="lab_visual" material="lab_floor" pos="2.0 0.725 -0.004" size="4.0 2.875 0.005"/>
    <geom name="lab_ply_near" class="lab_visual" material="lab_ply" pos="0.65 0 -0.003" size="1.247 1.0 0.005"/>
    <geom name="lab_ply_far" class="lab_visual" material="lab_ply" pos="3.15 0 -0.003" size="1.247 1.0 0.005"/>

    <!-- shell: back wall (doors), right wall behind the cabinets, left wall, ceiling -->
    <geom name="lab_wall_back" class="lab_shell" pos="6.05 0.725 1.75" size="0.05 2.875 1.75"/>
    <geom name="lab_wall_right" class="lab_shell" pos="2.0 -2.0 1.75" size="4.0 0.05 1.75"/>
    <geom name="lab_wall_left" class="lab_shell" pos="2.0 3.65 1.75" size="4.0 0.05 1.75"/>
    <geom name="lab_ceiling" class="lab_shell" contype="0" conaffinity="0" pos="2.0 0.725 3.55" size="4.0 2.875 0.05"/>
    <geom class="lab_visual" type="cylinder" group="4" material="lab_grey" fromto="-2 3.30 3.20 6 3.30 3.20" size="0.05"/>
    <geom class="lab_visual" type="cylinder" group="4" material="lab_grey" fromto="-2 2.95 3.35 6 2.95 3.35" size="0.04"/>
    <geom name="lab_door_main" class="lab_visual" material="lab_door" pos="5.995 -0.2 1.05" size="0.005 0.6 1.05"/>
    <geom class="lab_visual" material="lab_seam" pos="5.989 -0.2 1.05" size="0.002 0.004 1.05"/>
    <geom name="lab_door_side" class="lab_visual" material="lab_door" pos="5.995 -1.55 1.05" size="0.005 0.38 1.05"/>

    <!-- right: floor-to-ceiling white cabinets, front face at y = -1.35, ending 0.8 m short of the back wall -->
    <geom name="lab_cabinets" class="lab" material="lab_cabinet" pos="1.85 -1.65 1.3" size="3.35 0.3 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="1.85 -1.348 2.1" size="3.35 0.002 0.004"/>
    <geom class="lab_visual" material="lab_seam" pos="-0.9 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="-0.3 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="0.3 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="0.9 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="1.5 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="2.1 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="2.7 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="3.3 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="3.9 -1.348 1.3" size="0.004 0.002 1.3"/>
    <geom class="lab_visual" material="lab_seam" pos="4.5 -1.348 1.3" size="0.004 0.002 1.3"/>
    
    <!-- back right: cardboard box and a small black case -->
    <geom name="lab_box_back_right" class="lab" material="lab_cardboard" pos="5.6 -1.5 0.2" size="0.3 0.22 0.2"/>
    <geom name="lab_case_back_right" class="lab" material="lab_dark" pos="5.0 -1.2 0.1" size="0.1 0.1 0.1"/>

    <!-- back centre: tripod with the red camera -->
    <geom name="lab_tripod_leg_1" class="lab" type="capsule" material="lab_dark" fromto="5.3 -0.2 1.25 5.65 -0.2 0.01" size="0.012"/>
    <geom name="lab_tripod_leg_2" class="lab" type="capsule" material="lab_dark" fromto="5.3 -0.2 1.25 5.125 0.103 0.01" size="0.012"/>
    <geom name="lab_tripod_leg_3" class="lab" type="capsule" material="lab_dark" fromto="5.3 -0.2 1.25 5.125 -0.503 0.01" size="0.012"/>
    <geom name="lab_tripod_column" class="lab" type="capsule" material="lab_dark" fromto="5.3 -0.2 1.0 5.3 -0.2 1.42" size="0.015"/>
    <geom name="lab_tripod_camera" class="lab" material="lab_red" pos="5.3 -0.2 1.47" size="0.05 0.07 0.05"/>

    <!-- back left: wheelchair, fan, black panel, boxes, bookshelf -->
    <geom name="lab_wheelchair_seat" class="lab" material="lab_dark" pos="5.4 0.6 0.5" size="0.22 0.22 0.02"/>
    <geom name="lab_wheelchair_back" class="lab" material="lab_dark" pos="5.62 0.6 0.75" size="0.02 0.22 0.25"/>
    <geom name="lab_wheelchair_wheel_l" class="lab" type="cylinder" material="lab_grey" pos="5.45 0.87 0.3" euler="1.5708 0 0" size="0.3 0.015"/>
    <geom name="lab_wheelchair_wheel_r" class="lab" type="cylinder" material="lab_grey" pos="5.45 0.33 0.3" euler="1.5708 0 0" size="0.3 0.015"/>
    <geom name="lab_fan_base" class="lab" type="cylinder" material="lab_cabinet" pos="5.45 1.9 0.01" size="0.15 0.01"/>
    <geom name="lab_fan_pole" class="lab" type="capsule" material="lab_cabinet" fromto="5.45 1.9 0.02 5.45 1.9 1.05" size="0.015"/>
    <geom name="lab_fan_head" class="lab" type="cylinder" material="lab_cabinet" pos="5.43 1.9 1.2" euler="0 1.5708 0" size="0.2 0.06"/>
    <geom name="lab_black_panel" class="lab" material="lab_dark" pos="5.75 1.55 1.0" size="0.05 0.3 1.0"/>
    <geom name="lab_box_back_left_1" class="lab" material="lab_cardboard" pos="5.35 2.5 0.2" size="0.25 0.2 0.2"/>
    <geom name="lab_box_back_left_2" class="lab" material="lab_cardboard" pos="5.35 2.5 0.55" size="0.2 0.18 0.15"/>
    <geom name="lab_shelf" class="lab" material="lab_wood" pos="5.8 2.95 0.9" size="0.175 0.45 0.9"/>

    <!-- left: padded white pillar, blue patient lift, two weight plates by the plywood -->
    <geom name="lab_pillar" class="lab" material="lab_wall" pos="2.6 1.8 1.75" size="0.18 0.18 1.75"/>
    <geom class="lab_visual" type="cylinder" material="lab_cabinet" pos="2.6 1.8 0.35" size="0.24 0.13"/>
    <geom class="lab_visual" type="cylinder" material="lab_cabinet" pos="2.6 1.8 0.7" size="0.24 0.13"/>
    <geom class="lab_visual" type="cylinder" material="lab_cabinet" pos="2.6 1.8 1.05" size="0.24 0.13"/>
    <geom class="lab_visual" type="cylinder" material="lab_cabinet" pos="2.6 1.8 1.4" size="0.24 0.13"/>
    <geom class="lab_visual" type="cylinder" material="lab_cabinet" pos="2.6 1.8 1.75" size="0.24 0.13"/>
    <geom name="lab_lift_base_1" class="lab" type="capsule" material="lab_blue" fromto="2.0 2.75 0.06 2.9 2.75 0.06" size="0.03"/>
    <geom name="lab_lift_base_2" class="lab" type="capsule" material="lab_blue" fromto="2.0 3.35 0.06 2.9 3.35 0.06" size="0.03"/>
    <geom name="lab_lift_cross" class="lab" type="capsule" material="lab_blue" fromto="2.9 2.75 0.06 2.9 3.35 0.06" size="0.03"/>
    <geom name="lab_lift_mast" class="lab" type="capsule" material="lab_blue" fromto="2.9 3.05 0.06 2.9 3.05 1.6" size="0.04"/>
    <geom name="lab_lift_boom" class="lab" type="capsule" material="lab_blue" fromto="2.9 3.05 1.55 2.2 2.8 1.75" size="0.035"/>
    <geom name="lab_plate_1" class="lab" type="cylinder" material="lab_dark" pos="2.9 1.3 0.025" size="0.22 0.025"/>
    <geom name="lab_plate_2" class="lab" type="cylinder" material="lab_dark" pos="3.35 1.38 0.025" size="0.22 0.025"/>

    <!-- near left: equipment cases on the floor -->
    <geom name="lab_case_left_1" class="lab" material="lab_grey" pos="0.8 2.4 0.3" size="0.3 0.25 0.3"/>
    <geom name="lab_case_left_2" class="lab" material="lab_dark" pos="1.4 2.65 0.2" size="0.25 0.2 0.2"/>
  </worldbody>
</mujoco>
